# Shop desk — no Stripe secrets belong in this repository.
# Point at the live shop or a local GoldenGooseTools checkout.
NEXT_PUBLIC_SHOP_ORIGIN=https://www.goldengoosetools.com

# Price mirrored from shop config / parameter store.
# Cos brief example only: $7 = 700 cents. Not a source of truth.
# Leave unset if the shop has not published the key yet — the UI will not invent a figure.
NEXT_PUBLIC_PRICE_CENTS=700

# Serve this app under the shop path. Leave empty for local standalone (`/`).
# For goldengoosetools.com/tools/listing-optimizer set:
# NEXT_PUBLIC_BASE_PATH=/tools/listing-optimizer
NEXT_PUBLIC_BASE_PATH=

# Comma list of products the shop sale desk currently accepts.
# Default when unset: seo-audit,accessibility. Until listing-optimizer appears,
# this app refuses checkout (no fallthrough to SEO pricing).
# NEXT_PUBLIC_SHOP_SALE_PRODUCTS=seo-audit,accessibility,listing-optimizer
NEXT_PUBLIC_SHOP_SALE_PRODUCTS=seo-audit,accessibility

# Local-only unlock when the shop desk is not configured. Never enable in production.
NEXT_PUBLIC_ALLOW_LOCAL_UNLOCK=false
